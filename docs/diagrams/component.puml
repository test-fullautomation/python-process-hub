@startuml component
!theme plain
title Process Hub - Component Diagram

' ============================================================================
' Color scheme
' ============================================================================

skinparam ranksep 40
skinparam nodesep 20

skinparam package {
    BackgroundColor<<runtime>>   #FFF3E0
    BorderColor<<runtime>>       #E65100
    BackgroundColor<<core>>      #E3F2FD
    BorderColor<<core>>          #1565C0
    BackgroundColor<<transport>> #E8F5E9
    BorderColor<<transport>>     #2E7D32
    BackgroundColor<<process>>   #FCE4EC
    BorderColor<<process>>       #AD1457
    BackgroundColor<<config>>    #F3E5F5
    BorderColor<<config>>        #7B1FA2
    BackgroundColor<<logging>>   #F1F8E9
    BorderColor<<logging>>       #558B2F
    BackgroundColor<<ui>>        #E8EAF6
    BorderColor<<ui>>            #283593
    FontStyle bold
}

skinparam component {
    BackgroundColor<<rt>>   #FFE0B2
    BorderColor<<rt>>       #E65100
    BackgroundColor<<cr>>   #BBDEFB
    BorderColor<<cr>>       #1565C0
    BackgroundColor<<tp>>   #C8E6C9
    BorderColor<<tp>>       #2E7D32
    BackgroundColor<<pr>>   #F8BBD0
    BorderColor<<pr>>       #AD1457
    BackgroundColor<<cf>>   #E1BEE7
    BorderColor<<cf>>       #7B1FA2
    BackgroundColor<<lg>>   #DCEDC8
    BorderColor<<lg>>       #558B2F
    BackgroundColor<<uic>>  #C5CAE9
    BorderColor<<uic>>      #283593
}

skinparam interface {
    BackgroundColor #FAFAFA
    BorderColor #757575
}

skinparam arrow {
    Color #546E7A
    Thickness 1.5
}

skinparam note {
    BackgroundColor #FAFAFA
    BorderColor #BDBDBD
}

' ============================================================================
' Row 1: transport + ui  (interfaces)
' ============================================================================

package "transport" <<transport>> {
    interface "TransportBase" as transport_base
    component [ZmqTransport]      <<tp>> as zmq
    component [ZmqBroker]         <<tp>> as broker
    component [ZmqAsyncClient]    <<tp>> as zmq_client
    component [InMemoryTransport] <<tp>> as inmem

    zmq .up.|> transport_base
    inmem .up.|> transport_base
    zmq --> broker : uses
    zmq --> zmq_client : uses
}

package "ui" <<ui>> {
    interface "HubView" as view_if
    component [ConsoleView] <<uic>> as console
    component [WebView]     <<uic>> as webview
    component [NullView]    <<uic>> as null_view

    console ..|> view_if
    webview ..|> view_if
    null_view ..|> view_if
}

' ============================================================================
' Row 2: runtime  (entry point)
' ============================================================================

package "runtime" <<runtime>> {
    component [ProcessHubServer]  <<rt>> as server
    component [ProcessHubClient]  <<rt>> as client
    component [ClientController]  <<rt>> as controller
}

' ============================================================================
' Row 3: core + process  (business logic + execution)
' ============================================================================

package "core" <<core>> {
    component [ProcessHubCore]      <<cr>> as core_hub
    component [ProcessRegistry]     <<cr>> as registry
    component [RestartStateMachine] <<cr>> as restart_fsm
    component [models]              <<cr>> as models
}

package "process" <<process>> {
    interface "ProcessExecutor" as executor_if
    component [ProcessManager]   <<pr>> as proc_mgr
    component [SimpleExecutor]   <<pr>> as simple_exec
    component [MockExecutor]     <<pr>> as mock_exec
    component [PlatformExecutor] <<pr>> as platform_exec

    simple_exec ..|> executor_if
    mock_exec ..|> executor_if

    note bottom of platform_exec
      WindowsExecutor
      UnixExecutor
    end note
}

' ============================================================================
' Row 4: config + logging  (support)
' ============================================================================

package "config" <<config>> {
    component [ConfigLoader] <<cf>> as config_loader
    component [schemas]      <<cf>> as schemas
    config_loader --> schemas : validates
}

package "logging" <<logging>> {
    component [LoggingIntegration]   <<lg>> as log_int
    component [LoggingAwareExecutor] <<lg>> as log_exec
    component [MockLoggingServer]    <<lg>> as mock_log
    log_int --> mock_log : can use
}

' ============================================================================
' Layout control
'
'   transport  |  ui             ← Row 1
'        runtime                 ← Row 2
'     core  |  process           ← Row 3
'    config  |  logging          ← Row 4
'
' Use long-form down arrows (---->) for strong vertical pull
' ============================================================================

transport -[hidden]right- ui
transport --[hidden]down-- runtime
ui        --[hidden]down-- runtime
runtime   --[hidden]down-- core
runtime   --[hidden]down-- process
core      --[hidden]down-- config
process   --[hidden]down-- logging

' ============================================================================
' Cross-package dependencies
' (use --- long arrows to reinforce vertical layout)
' ============================================================================

' runtime → transport / ui (UP to row 1)
server -up-> transport_base #2E7D32  : uses
client -up-> transport_base #2E7D32  : uses
server -up-> view_if #283593         : renders to

' runtime → core / process (DOWN to row 3)
server -down-> core_hub #E65100      : delegates to
server -down-> executor_if #AD1457   : uses
client -down-> controller #E65100    : dispatches to

' core internals
core_hub --> registry #1565C0        : manages
core_hub --> restart_fsm #1565C0     : coordinates
core_hub --> models #1565C0          : uses

' process → core
proc_mgr --> executor_if #AD1457     : uses
proc_mgr --> registry #1565C0        : tracks

' logging → process
log_int --> log_exec #558B2F         : provides
log_exec ..> executor_if #AD1457     : wraps

' ============================================================================
' Notes
' ============================================================================

note right of server
  **Entry Point**
  Thin wrapper
  Transport wiring
  Main loop
end note

note top of core_hub
  **Business Logic**
  Message handling
  Health monitoring
end note

note bottom of webview
  FastAPI dashboard
  REST API
end note

@enduml
