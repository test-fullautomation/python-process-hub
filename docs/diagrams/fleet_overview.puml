@startuml fleet_overview
!theme plain
title Fleet Orchestrator - System Overview

skinparam rectangle {
    BackgroundColor<<orchestrator>> LightBlue
    BackgroundColor<<hub>> LightGreen
    BackgroundColor<<client>> LightYellow
    BackgroundColor<<transport>> LightGray
    BackgroundColor<<web>> #F3E5F5
}

rectangle "Fleet Orchestrator (Central PC)" <<orchestrator>> {
    rectangle "FleetOrchestrator\n(Central Coordinator)" as orch
    rectangle "HubRegistry\n(Thread-safe Hub Tracking)" as registry
    rectangle "FleetWebAPI\n(REST + Dashboard)" as web_api
}

rectangle "Fleet Transport" <<transport>> {
    rectangle "EventBusTransport\n(RabbitMQ)" as event_bus
    rectangle "fleet.* Routing Keys" as routing
}

rectangle "Hub PC 1" <<hub>> {
    rectangle "ProcessHubServer" as server1
    rectangle "HubAgent\n(Sidecar)" as agent1
    rectangle "Managed Processes" as procs1
}

rectangle "Hub PC 2" <<hub>> {
    rectangle "ProcessHubServer" as server2
    rectangle "HubAgent\n(Sidecar)" as agent2
    rectangle "Managed Processes" as procs2
}

rectangle "Hub PC N" <<hub>> {
    rectangle "ProcessHubServer" as serverN
    rectangle "HubAgent\n(Sidecar)" as agentN
    rectangle "Managed Processes" as procsN
}

rectangle "External Consumers" <<client>> {
    rectangle "FleetClient\n(CI/CD API)" as fleet_client
    rectangle "CLI / Scripts" as cli
}

rectangle "Web Dashboard" <<web>> {
    rectangle "Browser\n(Auto-refresh)" as browser
}

' Orchestrator internals
orch --> registry : manages
web_api --> orch : queries & commands

' Transport connections
orch --> event_bus : send/receive
agent1 --> event_bus : heartbeat + status
agent2 --> event_bus : heartbeat + status
agentN --> event_bus : heartbeat + status
event_bus --> routing : routes via

' Hub internals
agent1 --> server1 : public API
agent2 --> server2 : public API
agentN --> serverN : public API
server1 --> procs1 : manages
server2 --> procs2 : manages
serverN --> procsN : manages

' Client connections
fleet_client --> orch : status queries
fleet_client --> event_bus : commands
cli --> fleet_client : uses

' Web connections
browser --> web_api : HTTP

note right of orch
  **Fleet Overlay Pattern:**
  - No modifications to core/
  - HubAgent uses only public APIs
  - Each hub works independently
  - Orchestrator is optional
end note

note bottom of event_bus
  **Fleet Topics:**
  fleet.FLEET_HUB_ANNOUNCE
  fleet.FLEET_COMMAND
  fleet.FLEET_COMMAND_RESULT
  fleet.FLEET_HUB_ONLINE
  fleet.FLEET_HUB_OFFLINE
end note

@enduml
